# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# LVGL 内置 malloc 池大小(KB)。它是独立静态区、不与系统堆共享,配大了会白白占用 RAM。
# 本 demo UI 简单,24KB 足够;若自建复杂界面出现绘制卡死/看门狗,调大此值。
CONFIG_LV_MEM_SIZE_KILOBYTES=24

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# --- Bluetooth LE / NimBLE ---
# ESP32-C3 仅支持 BLE；示例只启用单连接 peripheral 所需的最小 host 配置。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n

# ============================================================================
# soundcore Work (D3200) 模拟器
# ============================================================================
# 录音页计时器字体。
CONFIG_LV_FONT_MONTSERRAT_32=y

# app_main 首次启动生成自签名 TLS 证书(ECDSA 签名),默认 3.5 KB 栈不够。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# BLE:实时音频约 9 KB/s 的通知吞吐,需要大 MTU 与足够的通知缓冲。
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=16
# 单连接 peripheral、只做传统广播、不配对:默认缓冲按多连接/扫描配置,
# 实测 BLE 启动吃掉约 70 KB 堆,裁到实际需要的量。
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=15
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=8
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=2
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_MAX_CCCDS=2
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_CTRL_BLE_MAX_ACT=2
CONFIG_BT_CTRL_BLE_SCAN=n
# NimBLE 默认 INFO 日志每条通知打两行(实时传输约 80 行/秒),拖慢 host 任务。
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# Wi-Fi 快速导出:SoftAP + wss:// WebSocket(客户端只连 wss,信任任意证书)。
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_HTTPD_WS_SUPPORT=y
# 无 PSRAM:TLS 记录缓冲按需分配,发送方向用 4 KB 记录。
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
# Wi-Fi 静态接收缓冲每个约 1.6 KB,导出时 BLE 已关闭,6 个足够。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16

# ---- 内部 RAM 预算(无 PSRAM:BLE 约 60 KB,Wi-Fi + TLS 约 90 KB,两者不同时运行)----
# LVGL 9 不认 LV_MEM_SIZE_KILOBYTES(上面的 24 被忽略,池子回落到默认 64 KB);
# 本界面约 60 个对象,32 KB 足够。
CONFIG_LV_MEM_SIZE=32768
# 把非 ISR 的 FreeRTOS 函数与 Wi-Fi 快速路径从 IRAM 移到闪存,换回约 25 KB 堆。
# Wi-Fi 吞吐略降,对导出(数百 KB/s 量级的需求)无影响。
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# WebSocket 升级请求带 Host/Upgrade/Key/UA/Accept-Encoding 等头部,留足余量。
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
